{
  "name": "media-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The MediaLibrary Micro-UI (system media): its type check, lint and tests. The shell bundles src/index.ts by the name its micro-ui.json gives.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^21.1.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
