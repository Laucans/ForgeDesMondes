  "invariants": [
    {
      "id": "present-only-pj",
      "onViolation": "reject",
      "rule": "Seuls des PJ de la même campagne peuvent être cochés présents. Les PJ proposés en DM view et sur les battlemaps sont exactement les présents, y compris ceux ajoutés plus tard."
    },
    {
      "id": "oneshot-single-session",
      "onViolation": "reject",
      "rule": "Un oneshot a exactement une séance : on ne peut pas lui en ajouter une autre. Une nouvelle séance d'une campagne prend la position qui suit la dernière."
    },
    {
      "id": "scene-order-contiguous",
      "onViolation": "reject",
      "rule": "Les rangs des scènes d'une séance vont de 1 à n, sans trou ni doublon. Un réordonnancement réécrit tous les rangs d'un coup."
    },
    {
      "id": "scene-links-same-campaign",
      "onViolation": "reject",
      "rule": "Les éléments et médias liés à une scène appartiennent à la campagne de la séance."
    },
    {
      "id": "session-media-by-place",
      "onViolation": "reject",
      "rule": "Un média est associé à une séance s'il est lié à une de ses scènes ou si son lieu figure dans une de ses scènes. Cette association n'est jamais stockée, elle suit donc tout changement de lieu. Un média sans lieu reste valide."
    },
    {
      "id": "brief-no-auto-creation",
      "onViolation": "reject",
      "rule": "L'analyse d'un brief lie les éléments existants à leurs scènes et met à jour les PNJ existants avec une version et son diff. Tout élément inconnu va dans la liste « à créer » avec son type et son extrait. Aucun élément n'est créé automatiquement."
    },
    {
      "id": "to-create-leaves-once-created",
      "onViolation": "reject",
      "rule": "Une entrée « à créer » passe à « creee » si et seulement si created_entity_id est renseigné. La proposition affinée tient compte de l'extrait et des phrases ajoutées."
    },
    {
      "id": "status-lifecycle",
      "onViolation": "reject",
      "rule": "Une séance passe de « prep » à « live » puis à « closed », sans retour en arrière. Une séance close n'accepte plus de lignes de journal."
    },
    {
      "id": "close-session",
      "onViolation": "reject",
      "rule": "Clore une séance éteint le micro, arrête les sons, conserve le journal horodaté en local et enregistre le résumé avec le modèle de résumé configuré."
    },
    {
      "id": "text-only-no-audio",
      "onViolation": "reject",
      "rule": "Aucune colonne ne contient d'audio. Les briefs et le journal ne sont conservés qu'en texte transcrit en local, et seul ce texte part vers le fournisseur."
    },
    {
      "id": "previous-summary-visible",
      "onViolation": "reject",
      "rule": "Le résumé et le journal de la séance close qui précède sont lisibles depuis la séance suivante, et le résumé figure dans la liste des séances."
    }
  ],
