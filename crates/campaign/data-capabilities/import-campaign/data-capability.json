{
  "dataCapability": "campaign.importCampaign",
  "owner": "dataguard",
  "version": 1,
  "effect": "insert",
  "target": {
    "aggregate": "Campaign",
    "id": "$id"
  },
  "touches": [
    "Campaign.id",
    "Campaign.name",
    "Campaign.kind",
    "Campaign.pitch",
    "Campaign.art",
    "Campaign.glyph",
    "Campaign.coverMediaId",
    "Campaign.createdAt",
    "Campaign.importedAt",
    "Campaign.originCampaignId",
    "Campaign.soundMasterVolume"
  ],
  "payload": {
    "archive": "object | string — a campaign archive (format campaign-archive, version 1) as campaign.exportCampaign wrote it, or the text of that JSON; always imported as a new campaign, whatever campaign it was made from (import-creates-copy)"
  },
  "mode": "overwrite",
  "invariants": [
    "import-creates-copy"
  ],
  "permissions": [],
  "callableBy": [
    "*"
  ],
  "idempotencyKey": "optional"
}
