{
  "dataCapability": "campaign.restoreEntityVersion",
  "owner": "dataguard",
  "version": 1,
  "effect": "update",
  "target": {
    "aggregate": "Entity",
    "id": "$entityId"
  },
  "touches": [
    "Entity.type",
    "Entity.name",
    "Entity.description",
    "Entity.notes",
    "Entity.updatedAt",
    "Entity.characterEntityId",
    "Entity.playerId",
    "Entity.initialPrompt",
    "Entity.background",
    "Entity.behavior",
    "Entity.strength",
    "Entity.dexterity",
    "Entity.constitution",
    "Entity.intelligence",
    "Entity.wisdom",
    "Entity.charisma",
    "Entity.armorClass",
    "Entity.hpMax",
    "Entity.spells",
    "Entity.actions",
    "Entity.portraitMediaId",
    "Entity.tokenMediaId",
    "Entity.tokenCrop",
    "Entity.tokenColor",
    "Entity.dndbeyondId",
    "Entity.dndbeyondSyncedAt",
    "Entity.entityAliasId",
    "Entity.entityAliasEntityId",
    "Entity.alias",
    "Entity.entityVersionId",
    "Entity.entityVersionEntityId",
    "Entity.versionNumber",
    "Entity.source",
    "Entity.snapshot",
    "Entity.diff",
    "Entity.restoredFromVersionId",
    "Entity.entityVersionCreatedAt"
  ],
  "payload": {
    "version": "integer | uuid — the version restored: its number in the element's history, or its id; a version of another element is refused",
    "changes": "integer[] — optional: only these changes of the version after `version`, by position in its diff, are undone, each field back to `version`'s value"
  },
  "mode": "confirm_on_stale",
  "invariants": [
    "restore-exact",
    "every-change-versioned",
    "alias-unique-in-campaign",
    "character-is-pj-or-pnj",
    "default-token",
    "explicit-save-only"
  ],
  "permissions": [],
  "callableBy": ["*"],
  "idempotencyKey": "optional"
}
