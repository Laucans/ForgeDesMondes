  "holds": {
    "maxTtl": "15m",
    "renewable": true
  },
  "invariants": [
    {
      "id": "grid-only-for-battlemap",
      "onViolation": "reject",
      "rule": "Seule une battlemap a un réglage de grille, et elle en a toujours un dès son téléversement."
    },
    {
      "id": "hex-is-five-feet",
      "onViolation": "reject",
      "rule": "Un hex vaut toujours 5 pieds, quels que soient sa taille, son décalage ou son orientation."
    },
    {
      "id": "grid-values-range",
      "onViolation": "reject",
      "rule": "La taille d'un hex est strictement positive et l'opacité reste entre 0 et 1."
    },
    {
      "id": "media-place-is-lieu",
      "onViolation": "reject",
      "rule": "Le lieu d'un média, s'il est renseigné, est un élément de type « lieu » de la même campagne."
    }
  ],
  "relations": [
    {
      "from": "Media.campaignId",
      "onDelete": "cascade",
      "onUpdate": "propagate"
    },
    {
      "from": "Media.placeId",
      "onDelete": "nullify",
      "onUpdate": "propagate"
    },
    {
      "from": "Media.mediaId",
      "onDelete": "cascade",
      "onUpdate": "propagate"
    }
  ]
}
