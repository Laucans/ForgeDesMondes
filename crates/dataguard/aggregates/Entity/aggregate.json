  "invariants": [
    {
      "id": "character-is-pj-or-pnj",
      "onViolation": "reject",
      "rule": "Une fiche de personnage n'existe que pour un élément de type « pj » ou « pnj ». player_id n'est renseigné que pour un PJ, et le joueur appartient à la même campagne."
    },
    {
      "id": "alias-unique-in-campaign",
      "onViolation": "reject",
      "rule": "Un alias, une fois normalisé, ne désigne qu'un seul élément d'une campagne et ne double pas le nom d'un autre élément."
    },
    {
      "id": "every-change-versioned",
      "onViolation": "reject",
      "rule": "Tout enregistrement de l'élément ou de sa fiche, quelle que soit sa source (DM, IA, D&D Beyond, brief, restauration), ajoute une version avec son instantané complet et son diff. Les versions ne sont jamais modifiées."
    },
    {
      "id": "restore-exact",
      "onViolation": "reject",
      "rule": "Revenir à une version, ou annuler un changement, réécrit l'élément, sa fiche et ses alias exactement comme dans l'instantané visé, et ajoute une version de source « restauration »."
    },
    {
      "id": "dndbeyond-resync-scope",
      "onViolation": "reject",
      "rule": "Une resynchronisation D&D Beyond ne change que les caractéristiques, la CA, les PV max, les sorts et les actions. Les alias, les notes, le token et le portrait restent inchangés."
    },
    {
      "id": "proposal-fills-sheet-fields",
      "onViolation": "reject",
      "rule": "Une proposition IA remplit background, comportement, caractéristiques, CA, PV max et actions dans les mêmes champs, quel que soit le fournisseur. Elle n'est construite qu'à partir de texte."
    },
    {
      "id": "explicit-save-only",
      "onViolation": "reject",
      "rule": "Seul un enregistrement explicite du DM écrit la fiche. Une modification non enregistrée n'est jamais écrite, et « Enregistrer et continuer » écrit avant la navigation."
    },
    {
      "id": "default-token",
      "onViolation": "reject",
      "rule": "Sans image de token ni portrait, le token s'affiche comme une pastille de token_color portant l'initiale du nom. Avec un portrait recadré, il affiche ce recadrage."
    },
    {
      "id": "dex-modifier-derived",
      "onViolation": "reject",
      "rule": "Le modificateur de DEX vaut toujours floor((DEX - 10) / 2) et n'est jamais saisi."
    }
  ],
  "relations": [
    {
      "from": "Entity.entityCampaignId",
      "onDelete": "cascade",
      "onUpdate": "propagate"
    },
    {
      "from": "Entity.characterEntityId",
