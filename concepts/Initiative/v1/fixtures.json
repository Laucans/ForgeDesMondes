{
  "concept": "Initiative",
  "version": 1,
  "cases": [
    {
      "name": "an NPC with DEX 16 rolling 11 has initiative 14 (11 + 3)",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 16,
        "roll": 11
      },
      "output": {
        "roll": 11,
        "dexModifier": 3,
        "initiative": 14
      }
    },
    {
      "name": "an NPC with DEX 12 rolling 13 has initiative 14 (13 + 1)",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 12,
        "roll": 13
      },
      "output": {
        "roll": 13,
        "dexModifier": 1,
        "initiative": 14
      }
    },
    {
      "name": "a PC has no roll: its initiative is the figure the DM entered",
      "input": {
        "operation": "initiative",
        "kind": "pc",
        "enteredInitiative": 14
      },
      "output": {
        "roll": null,
        "dexModifier": null,
        "initiative": 14
      }
    },
    {
      "name": "DEX 10 gives no modifier",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 10,
        "roll": 8
      },
      "output": {
        "roll": 8,
        "dexModifier": 0,
        "initiative": 8
      }
    },
    {
      "name": "DEX 9 gives -1: the modifier is floored, not truncated",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 9,
        "roll": 1
      },
      "output": {
        "roll": 1,
        "dexModifier": -1,
        "initiative": 0
      }
    },
    {
      "name": "DEX 1 gives -5 and the lowest roll still counts",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 1,
        "roll": 1
      },
      "output": {
        "roll": 1,
        "dexModifier": -5,
        "initiative": -4
      }
    },
    {
      "name": "DEX 20 rolling the top of the die gives 25",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 20,
        "roll": 20
      },
      "output": {
        "roll": 20,
        "dexModifier": 5,
        "initiative": 25
      }
    },
    {
      "name": "an odd DEX floors to the lower modifier: DEX 15 gives +2",
      "input": {
        "operation": "initiative",
        "kind": "npc",
        "dex": 15,
        "roll": 12
      },
      "output": {
        "roll": 12,
        "dexModifier": 2,
        "initiative": 14
      }
    },
    {
      "name": "R105: at 14 all round, DEX 16 comes first and an equal DEX goes to the higher draw",
      "input": {
        "operation": "order",
        "participants": [
          {
            "id": "pc-entered",
            "initiative": 14,
            "dex": 12,
            "draw": 2
          },
          {
            "id": "npc-dex-12",
            "initiative": 14,
            "dex": 12,
            "draw": 9
          },
          {
            "id": "npc-dex-16",
            "initiative": 14,
            "dex": 16,
            "draw": 5
          }
        ]
      },
      "output": {
        "order": [
          "npc-dex-16",
          "npc-dex-12",
          "pc-entered"
        ]
      }
    },
    {
      "name": "R105: the same tie with the draws swapped goes the other way",
      "input": {
        "operation": "order",
        "participants": [
          {
            "id": "pc-entered",
            "initiative": 14,
            "dex": 12,
            "draw": 9
          },
          {
            "id": "npc-dex-12",
            "initiative": 14,
            "dex": 12,
            "draw": 2
          },
          {
            "id": "npc-dex-16",
            "initiative": 14,
            "dex": 16,
            "draw": 5
          }
        ]
      },
      "output": {
        "order": [
          "npc-dex-16",
          "pc-entered",
          "npc-dex-12"
        ]
      }
    },
    {
