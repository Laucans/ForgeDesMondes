        "hp_current": 1,
        "hp_max": 20
      },
      "output": {
        "band": "en sang"
      }
    },
    {
      "name": "an odd maximum: 4 of 7 is above half",
      "input": {
        "hp_current": 4,
        "hp_max": 7
      },
      "output": {
        "band": "blessé"
      }
    },
    {
      "name": "an odd maximum: 3 of 7 is under half",
      "input": {
        "hp_current": 3,
        "hp_max": 7
      },
      "output": {
        "band": "en sang"
      }
    },
    {
      "name": "a maximum of 1: at 1 it is unhurt",
      "input": {
        "hp_current": 1,
        "hp_max": 1
      },
      "output": {
        "band": "indemne"
      }
    },
    {
      "name": "a maximum of 1: at 0 it is dead",
      "input": {
        "hp_current": 0,
        "hp_max": 1
      },
      "output": {
        "band": "mort"
      }
    },
    {
      "name": "a maximum of 2: at 1 it is at half, so bloodied",
